# ─────────────────────────────────────────────────────────────────────────────
# AUTOTUBER — Environment Variables
# Copy this file to .env and fill in real values
# Frontend vars must be prefixed with VITE_
# ─────────────────────────────────────────────────────────────────────────────

# ── SUPABASE (required for real auth + database) ──────────────────────────────
# Get from: https://app.supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only (never expose to frontend)
# Get from: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── STRIPE (required for real payments) ───────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Get from: Stripe Dashboard → Developers → Webhooks → Add endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── STRIPE PRICE IDs (create products/prices in Stripe Dashboard) ─────────────
# Stripe Dashboard → Products → Create product → Add price (recurring)
STRIPE_PRICE_HOBBY=price_...      # $1.99/month
STRIPE_PRICE_CREATOR=price_...   # $9.99/month
STRIPE_PRICE_PRO=price_...       # $24.99/month

# ── APP URLS ───────────────────────────────────────────────────────────────────
# Local development
VITE_APP_URL=http://localhost:5173
# Production (update after deploying)
# VITE_APP_URL=https://yourdomain.com

# ── SERVER PORT ────────────────────────────────────────────────────────────────
PORT=3001

# ── OPTIONAL: Claude AI (if you have your own key) ────────────────────────────
# app works without this — uses shared key in code
VITE_CLAUDE_API_KEY=sk-ant-...

# ── OPTIONAL: ElevenLabs (can also be entered by users in Settings) ───────────
VITE_ELEVENLABS_API_KEY=...
